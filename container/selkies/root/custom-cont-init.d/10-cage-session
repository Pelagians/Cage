#!/usr/bin/with-contenv bash
set -Eeuo pipefail

# Create only Cage-owned roots. Never recursively chown the read-only bundle or
# other caller-supplied mounts beneath them.
install -d -o abc -g abc -m 0755 \
  /config \
  /config/.config \
  /var/lib/cage \
  /var/lib/cage/state \
  /opt/cage/logs \
  /tmp/cage-prefix \
  /exports
chown abc:abc /config /config/.config \
  /var/lib/cage /var/lib/cage/state /opt/cage/logs /tmp/cage-prefix /exports
