  "additionalProperties": false,
  "$defs": {
    "usbMatch": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "product": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "productRange": {
          "type": "object",
          "properties": {
            "first": {
              "type": "string",
              "pattern": "^[0-9a-f]{4}$",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            },
            "last": {
              "type": "string",
              "pattern": "^[0-9a-f]{4}$",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          },
          "required": [
            "first",
            "last"
          ],
          "additionalProperties": false
        },
        "class": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "subclass": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "serial": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "vendor"
          ]
        },
        {
          "required": [
            "class"
          ]
        }
      ],
      "allOf": [
        {
          "not": {
            "required": [
              "product",
              "productRange"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "product"
                ]
              },
              {
                "required": [
                  "productRange"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "vendor"
            ]
          }
        },
        {
          "if": {
            "required": [
              "subclass"
            ]
          },
          "then": {
            "required": [
              "class"
            ]
          }
        }
      ]
    }
