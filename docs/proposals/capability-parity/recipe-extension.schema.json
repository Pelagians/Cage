{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cage:design:recipe-permission-extension:v1",
  "title": "Proposed Cage v1 permission field projection",
  "description": "Design only. Validate the projection of new fields, not a full runnable application recipe. Semantic checks and existing field validators are specified in recipe-schema.md.",
  "type": "object",
  "properties": {
    "schemaVersion": {
