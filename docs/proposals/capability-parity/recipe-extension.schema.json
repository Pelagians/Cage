              "request",
              "grant"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "environment",
        "targets"
      ],
      "additionalProperties": false,
      "description": "Managed v1 always enforces the fixed baseline; ordinary host access is a separate v0 operation."
