                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                      "not": {
                        "pattern": "[\\u0000-\\u001f\\u007f]"
                      }
                    },
                    "minItems": 0,
                    "uniqueItems": true
